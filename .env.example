# Copie este arquivo para .env (o .env real nunca deve ir para o git) e
# preencha sua chave da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional - troque se quiser usar um modelo mais barato/rapido durante o dev
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low

# Modo de handoff humano:
# "site" (padrao) - o atendimento continua dentro do chat do site; nao gera
#         custo de WhatsApp Business API. O botao de handoff so abre o painel
#         do atendente (uso interno).
# "whatsapp" - encaminha o lead para o numero real abaixo via wa.me.
# HANDOFF_MODE=site
# WHATSAPP_BUSINESS_NUMBER=5511999999999

# MongoDB - guarda uma copia CIFRADA de toda interacao (mensagens do lead, do
# agente e do atendente, tentativas de cotacao, handoff etc.), sobrevivendo a
# reinicios do container. A chave de criptografia (Fernet/AES) fica so aqui,
# nunca no banco - por isso quem tiver acesso de admin ao MongoDB consegue ver
# os documentos, mas nao consegue ler o conteudo sem essa chave.
MONGO_ROOT_USER=autoseguro
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DB=autoseguro
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem essa chave (ou com uma invalida), a persistencia no Mongo fica desativada
# automaticamente - o agente nunca grava payload em texto claro no banco.
MONGO_ENCRYPTION_KEY=
