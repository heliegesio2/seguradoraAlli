<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram id="autoseguro-agent-flow" name="Fluxo do Agente">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Fluxo do Agente de Cotacao - AutoSeguro" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="-50" width="400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Lead envia mensagem via WhatsApp (webhook)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Carregar sessao da conversa (lead_id) ou criar nova + registrar mensagem (id, timestamp, status=recebida)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="NLU: extrair intencao e entidades (plano desejado, idade, ano do veiculo, CEP, data de inicio)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Criterio de handoff atingido?&#10;(pedido explicito de humano | fora do escopo de seguro auto | reclamacao/sinistro | 3+ falhas de compreensao | pedido de desconto/negociacao)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="290" y="390" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="Todos os dados obrigatorios foram coletados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="580" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Perguntar ao lead o(s) dado(s) faltante(s)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="600" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Validar dados: idade minima, ano do veiculo aceito, CEP valido, data de inicio >= hoje" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="730" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="Dados validos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="860" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="Explicar o erro encontrado e pedir correcao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="870" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="Chamar POST /quote (novo id de tentativa, status=pendente)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="1000" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="Resultado da chamada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="1120" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="Apresentar cotacao ao lead (valor, plano, vigencia); status=cotado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="290" y="1280" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n13" value="Tentativas &lt; limite (ex: 3) e dentro da janela de tempo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="1110" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n14" value="Aguardar backoff exponencial e tentar novamente" style="shape=process;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="1280" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n15" value="Registrar falha de infraestrutura (status=falha_quote); informar o lead sobre a instabilidade sem inventar preco" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="960" y="1100" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n16" value="Lead aceita aguardar nova tentativa assincrona?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="960" y="1260" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n17" value="Agendar retry assincrono e notificar o lead quando a cotacao sair; status=aguardando_retry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1260" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="nend2" value="Fim: aguardando retorno assincrono" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1400" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n18" value="Handoff: compilar contexto completo (historico, dados extraidos, motivo) e notificar vendedor humano; status=handoff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1000" y="390" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n19" value="Fim: conversa transferida para humano" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1040" y="550" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n20" value="Reacao do lead a cotacao?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="290" y="1410" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n21" value="Registrar aceite e encaminhar para fechamento/pagamento; status=fechado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="1600" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n22" value="Fim: venda fechada" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="1720" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n23" value="Registrar lead como perdido (motivo); status=perdido" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="360" y="1600" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n24" value="Fim: sem conversao" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="390" y="1720" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n25" value="Observacao transversal: toda mensagem, tentativa de cotacao e decisao do agente e persistida com id unico, timestamp e status (recebida, processando, cotado, falha_quote, handoff, fechado, perdido, aguardando_retry) - garante rastreabilidade fim a fim para auditoria." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=20;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="1000" width="220" height="260" as="geometry" />
        </mxCell>

